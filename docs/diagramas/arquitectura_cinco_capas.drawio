<mxfile host="app.diagrams.net"><diagram name="Arquitectura cinco capas RetailBI"><mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" page="1" pageWidth="1060" pageHeight="400"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;1. FUENTES DE DATOS&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:10px&amp;quot;&gt;&lt;b&gt;F1 · DANE, EMC&lt;/b&gt;&lt;br&gt;anex-EMC-ComercioMinorista (XLSX)&lt;br&gt;&lt;br&gt;&lt;b&gt;F2 · Datos Abiertos Bogotá&lt;/b&gt;&lt;br&gt;Dinámica empresarial (DBF/GPKG)&lt;br&gt;&lt;br&gt;&lt;b&gt;F3 · RetailBI_ventas_&lt;/b&gt;&lt;br&gt;&lt;b&gt;sinteticas_50000.csv (CSV)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=top;align=left;spacingLeft=6;fillColor=#EAF2FB;strokeColor=#4A78B0;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="215" height="190" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;2. INTEGRACIÓN (ETL)&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:10px&amp;quot;&gt;&lt;b&gt;Pentaho Data Integration&lt;/b&gt;&lt;br&gt;Job de carga por lotes&lt;br&gt;&lt;br&gt;&lt;b&gt;Esquema staging (PostgreSQL)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Normaliza fechas AAAA-MM-DD,&lt;br&gt;códigos y nombres; valida&lt;br&gt;duplicados y totales&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=top;align=left;spacingLeft=6;fillColor=#EAF2FB;strokeColor=#4A78B0;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="295" y="20" width="215" height="190" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;3. ALMACÉN DE DATOS&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:10px&amp;quot;&gt;&lt;b&gt;PostgreSQL · esquema dw&lt;/b&gt;&lt;br&gt;&lt;br&gt;Estrella: FactVentas&lt;br&gt;+ DimFecha, DimTienda,&lt;br&gt;DimProducto, DimDescuento&lt;br&gt;&lt;br&gt;Tablas de contexto F1 y F2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=top;align=left;spacingLeft=6;fillColor=#EAF2FB;strokeColor=#4A78B0;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="20" width="215" height="190" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;4. USUARIO FINAL&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:10px&amp;quot;&gt;&lt;b&gt;Power BI Desktop&lt;/b&gt;&lt;br&gt;(alternativa: Metabase)&lt;br&gt;&lt;br&gt;Gerente comercial y&lt;br&gt;responsables de tienda&lt;br&gt;&lt;br&gt;Ingresos, unidades y&lt;br&gt;descuentos por mes,&lt;br&gt;tienda y categoría&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=top;align=left;spacingLeft=6;fillColor=#EAF2FB;strokeColor=#4A78B0;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="845" y="20" width="195" height="190" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;5. GOBIERNO, METADATOS, MONITOREO Y SEGURIDAD (CAPA TRANSVERSAL)&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:10px&amp;quot;&gt;Diccionario de datos  ·  linaje fuente → reporte  ·  bitácora de cargas de PDI (filas leídas, cargadas y rechazadas)&lt;br&gt;Reglas de calidad  ·  roles y permisos de PostgreSQL  ·  respaldos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=top;align=center;spacingLeft=6;fillColor=#FFF6E5;strokeColor=#C08A2E;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="1020" height="90" as="geometry"/></mxCell><mxCell id="e0" value="extrae" style="edgeStyle=none;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=9;endArrow=block;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="carga" style="edgeStyle=none;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=9;endArrow=block;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="consulta" style="edgeStyle=none;html=1;exit